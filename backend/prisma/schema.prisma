generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================
// ROLE & USER MODELS
// ====================================

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

enum UserStatus {
  active // đang hoạt động
  inactive // không hoạt động
  terminated // bác sĩ kết thúc hợp đồng
  blocked // tài khoản bị khóa
}

model User {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String
  email     String  @unique
  password  String
  phone     String?
  gender    String?

  dateOfBirth   DateTime?
  avatar        String?
  streetAddress String?
  city          String?
  state         String?
  postalCode    String?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  status UserStatus @default(active)

  admin            Admin?
  patient          Patient?
  doctor           Doctor?
  nurse            Nurse[]
  notifications    Notification[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================
// ADMIN MODEL
// ====================================

model Admin {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  position String?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Specialty {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String? // icon frontend
  image       String? // banner hình
  isActive    Boolean @default(true)
  priority    Int     @default(0) // sắp xếp hiển thị

  // Relations
  doctors Doctor[]
  clinics ClinicSpecialty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Clinic {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  logo        String?
  images      Json? // gallery hình ảnh

  phone String?
  email String?

  address   String
  ward      String?
  district  String?
  city      String
  latitude  Float?
  longitude Float?

  openingTime String? // "08:00"
  closingTime String? // "17:00"
  isActive    Boolean @default(true)

  // Relations
  specialties  ClinicSpecialty[]
  doctors      Doctor[]          @relation("DoctorClinics")
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicSpecialty {
  id          Int @id @default(autoincrement())
  clinicId    Int
  specialtyId Int

  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([clinicId, specialtyId])
  @@index([clinicId])
  @@index([specialtyId])
}

// ====================================
// ROOM MODEL
// ====================================
model Room {
  id         Int    @id @default(autoincrement())
  roomNumber String @unique
  type       String // ICU, General, Private, Emergency
  status     String @default("available") // available, full, maintenance

  beds       Bed[]
  admissions Admission[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ====================================
// BED MODEL
// ====================================

model Bed {
  id        Int    @id @default(autoincrement())
  bedNumber String
  status    String @default("available") // available, occupied, cleaning

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================
// ADMINSSION MODEL
// ====================================

model Admission {
  id        Int  @id @default(autoincrement())
  patientId Int
  doctorId  Int?
  nurseId   Int?
  roomId    Int?
  bedId     Int?

  admissionDate DateTime  @default(now())
  dischargeDate DateTime?

  conditionOnAdmission String?
  conditionOnDischarge String?
  status               String  @default("admitted") // admitted, discharged, transferred

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor? @relation(fields: [doctorId], references: [id])
  nurse   Nurse?  @relation(fields: [nurseId], references: [id])
  room    Room?   @relation(fields: [roomId], references: [id])
  bed     Bed?    @relation(fields: [bedId], references: [id])

  finance                Finance[]
  conditionStatesUpdated ConditionState[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

// ====================================
// FINANCE MODEL
// ====================================

model Finance {
  id          Int  @id @default(autoincrement())
  admissionId Int?
  patientId   Int

  totalCost  Float
  paidAmount Float  @default(0)
  remaining  Float  @default(0)
  status     String @default("unpaid") // unpaid, partial, paid

  items Json? // [{ service: "X-ray", cost: 200000 }]

  patient   Patient    @relation(fields: [patientId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================
// Satisfaction MODEL
// ====================================

model Satisfaction {
  id            Int  @id @default(autoincrement())
  patientId     Int
  doctorId      Int?
  appointmentId Int?

  rating   Int // 1-5
  feedback String?
  category String? // nursing, doctor, service, facility

  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Doctor?      @relation(fields: [doctorId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
}

// ====================================
// ConditionState MODEL
// ====================================

model ConditionState {
  id          Int  @id @default(autoincrement())
  patientId   Int
  admissionId Int?

  condition String? // Stable, Critical, Severe, Improving, Normal
  notes     String?

  updatedByDoctorId Int?
  updatedByDoctor   Doctor? @relation(fields: [updatedByDoctorId], references: [id])

  patient   Patient    @relation(fields: [patientId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])

  createdAt DateTime @default(now())
}

// ====================================
// NURSE MODEL
// ====================================

model Nurse {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique
  shift        String?
  salary       Float?
  departmentId Int?

  user       User        @relation(fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================
// PATIENT MODEL
// ====================================

model Patient {
  id                     Int              @id @default(autoincrement())
  userId                 Int              @unique
  user                   User             @relation(fields: [userId], references: [id])
  age                    Int?
  condition              String?
  gender                 String?
  admissions             Admission[]
  finances               Finance[]
  prescription           Prescription[]
  medicalRecord          MedicalRecord[]
  payment                Payment[]
  feedback               Feedback[]
  appointment            Appointment[]
  satisfaction           Satisfaction[]
  conditionStatesUpdated ConditionState[]
}

// ====================================
// DEPARTMENT & DOCTOR MODELS
// ====================================

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  description String?

  doctors Doctor[]
  nurses  Nurse[]
}


model Doctor {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  specialization String
  experience     Int?
  bio            String?
  rating         Float?  @default(0.0)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  schedules              Schedule[]
  appointments           Appointment[]
  feedbacks              Feedback[]
  medicalRecords         MedicalRecord[]
  prescriptions          Prescription[]
  availability           Availability[]
  satisfaction           Satisfaction[]
  admissions             Admission[]
  // Relations
  specialties            Specialty[]
  clinics                Clinic[]         @relation("DoctorClinics") // Thêm tên relation
  conditionStatesUpdated ConditionState[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

// ====================================
// AVAILABILITY MODEL
// ====================================

model Availability {
  id       Int       @id @default(autoincrement())
  doctorId Int
  date     DateTime?
  start    DateTime?
  end      DateTime?
  doctor   Doctor    @relation(fields: [doctorId], references: [id])
}

// ====================================
// SCHEDULE & APPOINTMENT MODELS
// ====================================

model Schedule {
  id          Int      @id @default(autoincrement())
  doctorId    Int
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean  @default(true)

  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id         Int      @id @default(autoincrement())
  patientId  Int
  doctorId   Int
  clinicId   Int
  scheduleId Int?
  date       DateTime
  startTime  DateTime
  endTime    DateTime
  reason     String?
  status     String   @default("pending")

  patient  Patient   @relation(fields: [patientId], references: [id])
  schedule Schedule? @relation(fields: [scheduleId], references: [id])
  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  doctor   Doctor    @relation(fields: [doctorId], references: [id])
  feedback Feedback? @relation("AppointmentFeedback")
  payment  Payment?

  satisfaction Satisfaction[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ====================================
// FEEDBACK MODEL
// ====================================

model Feedback {
  id            Int     @id @default(autoincrement())
  patientId     Int
  doctorId      Int
  appointmentId Int?    @unique // ✅ thêm @unique
  rating        Int
  comment       String?

  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  appointment Appointment? @relation("AppointmentFeedback", fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
}

// ====================================
// PAYMENT MODEL
// ====================================

// ====================================
// PAYMENT MODEL - Updated for Hybrid Payment System
// ====================================

model Payment {
  id            Int @id @default(autoincrement())
  appointmentId Int @unique
  patientId     Int

  // Phí khám
  consultationFee Float // Phí khám gốc
  depositAmount   Float // Tiền đặt cọc (30-50% consultationFee)
  remainingAmount Float // Còn phải trả
  totalPaid       Float @default(0) // Tổng đã thanh toán

  // Trạng thái thanh toán
  depositStatus String @default("pending") // pending, paid, refunded, failed
  paymentStatus String @default("pending") // pending, partial, completed, refunded

  // Transaction IDs
  depositTransactionId String? // ID giao dịch đặt cọc
  finalTransactionId   String? // ID giao dịch thanh toán cuối

  // Phương thức thanh toán
  paymentMethod   String? // stripe, payos, cash, free_booking
  paymentProvider String? // stripe, payos (để phân biệt gateway)

  // Thông tin gateway
  stripePaymentIntentId String? // Stripe Payment Intent ID
  payosOrderId          String? // PayOS Order ID

  // Chi phí phát sinh (thuốc, xét nghiệm...)
  additionalCharges Json? @default("[]") // [{service: "Xét nghiệm", amount: 150000, status: "paid"}]

  // Refund policy
  refundAmount Float?    @default(0) // Số tiền đã hoàn
  refundReason String? // Lý do hoàn tiền
  refundedAt   DateTime?

  // Timestamps
  depositPaidAt DateTime?
  finalPaidAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([paymentStatus])
  @@index([depositStatus])
}

// ====================================
// PAYMENT TRANSACTION LOG (Optional - for audit)
// ====================================

model PaymentTransaction {
  id              Int      @id @default(autoincrement())
  paymentId       Int
  transactionType String // deposit, final_payment, refund, additional_charge
  amount          Float
  status          String // success, failed, pending
  provider        String // stripe, payos, cash
  transactionId   String? // External transaction ID
  metadata        Json? // Extra info from gateway
  createdAt       DateTime @default(now())

  @@index([paymentId])
  @@index([transactionId])
}

// ====================================
// MEDICAL RECORD & PRESCRIPTION MODELS
// ====================================

model MedicalRecord {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  patientId Int
  diagnosis String
  treatment String?
  notes     String?
  date      DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
}

model Prescription {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  patientId    Int
  medication   String
  dosage       String
  instructions String?
  createdAt    DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
}

// ====================================
// MESSAGE, NOTIFICATION, AUDIT LOG
// ====================================

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  sentAt     DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
