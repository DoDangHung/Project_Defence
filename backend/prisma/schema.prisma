generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================
// ROLE & USER MODELS
// ====================================

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

enum UserStatus {
  active       // đang hoạt động
  inactive     // không hoạt động
  terminated   // bác sĩ kết thúc hợp đồng
  blocked      // tài khoản bị khóa
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  phone    String?
  gender   String?
  roleId   Int
  role     Role    @relation(fields: [roleId], references: [id])
  status   UserStatus @default(active)
  admin            Admin?
  patient          Patient?
  notifications    Notification[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================
// ADMIN MODEL
// ====================================

model Admin {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  position String?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================
// PATIENT MODEL
// ====================================

model Patient {
  id             Int             @id @default(autoincrement())
  userId         Int             @unique
  address        String?
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  payments       Payment[]

  user      User       @relation(fields: [userId], references: [id])
  feedbacks Feedback[]
}

// ====================================
// DEPARTMENT & DOCTOR MODELS
// ====================================

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  doctors     Doctor[]
}

model Doctor {
  id             Int     @id @default(autoincrement())
  name           String
  email          String  @unique
  password       String
  phone          String?
  specialization String
  experience     Int?
  bio            String?
  rating         Float?  @default(0.0)
  departmentId   Int?

  department     Department?     @relation(fields: [departmentId], references: [id])
  schedules      Schedule[]
  appointments   Appointment[]
  feedbacks      Feedback[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  availability   Availability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================
// AVAILABILITY MODEL
// ====================================

model Availability {
  id       Int       @id @default(autoincrement())
  doctorId Int
  date     DateTime?
  start    DateTime?
  end      DateTime?
  doctor   Doctor    @relation(fields: [doctorId], references: [id])
}

// ====================================
// SCHEDULE & APPOINTMENT MODELS
// ====================================

model Schedule {
  id          Int      @id @default(autoincrement())
  doctorId    Int
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean  @default(true)

  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id         Int      @id @default(autoincrement())
  patientId  Int
  doctorId   Int
  scheduleId Int?
  date       DateTime
  startTime  DateTime
  endTime    DateTime
  reason     String?
  status     String   @default("pending")

  patient  Patient   @relation(fields: [patientId], references: [id])
  doctor   Doctor    @relation(fields: [doctorId], references: [id])
  schedule Schedule? @relation(fields: [scheduleId], references: [id])

  feedback Feedback? @relation("AppointmentFeedback")
  payment  Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================
// FEEDBACK MODEL
// ====================================

model Feedback {
  id            Int     @id @default(autoincrement())
  patientId     Int
  doctorId      Int
  appointmentId Int?    @unique // ✅ thêm @unique
  rating        Int
  comment       String?

  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  appointment Appointment? @relation("AppointmentFeedback", fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
}

// ====================================
// PAYMENT MODEL
// ====================================

// ====================================
// PAYMENT MODEL - Updated for Hybrid Payment System
// ====================================

model Payment {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  patientId     Int
  
  // Phí khám
  consultationFee  Float   // Phí khám gốc
  depositAmount    Float   // Tiền đặt cọc (30-50% consultationFee)
  remainingAmount  Float   // Còn phải trả
  totalPaid        Float   @default(0) // Tổng đã thanh toán
  
  // Trạng thái thanh toán
  depositStatus    String  @default("pending") // pending, paid, refunded, failed
  paymentStatus    String  @default("pending") // pending, partial, completed, refunded
  
  // Transaction IDs
  depositTransactionId  String? // ID giao dịch đặt cọc
  finalTransactionId    String? // ID giao dịch thanh toán cuối
  
  // Phương thức thanh toán
  paymentMethod    String? // stripe, payos, cash, free_booking
  paymentProvider  String? // stripe, payos (để phân biệt gateway)
  
  // Thông tin gateway
  stripePaymentIntentId String? // Stripe Payment Intent ID
  payosOrderId          String? // PayOS Order ID
  
  // Chi phí phát sinh (thuốc, xét nghiệm...)
  additionalCharges Json?  @default("[]") // [{service: "Xét nghiệm", amount: 150000, status: "paid"}]
  
  // Refund policy
  refundAmount     Float?  @default(0) // Số tiền đã hoàn
  refundReason     String? // Lý do hoàn tiền
  refundedAt       DateTime?
  
  // Timestamps
  depositPaidAt    DateTime?
  finalPaidAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id])
  
  @@index([patientId])
  @@index([paymentStatus])
  @@index([depositStatus])
}

// ====================================
// PAYMENT TRANSACTION LOG (Optional - for audit)
// ====================================

model PaymentTransaction {
  id              Int      @id @default(autoincrement())
  paymentId       Int
  transactionType String   // deposit, final_payment, refund, additional_charge
  amount          Float
  status          String   // success, failed, pending
  provider        String   // stripe, payos, cash
  transactionId   String?  // External transaction ID
  metadata        Json?    // Extra info from gateway
  createdAt       DateTime @default(now())
  
  @@index([paymentId])
  @@index([transactionId])
}

// ====================================
// MEDICAL RECORD & PRESCRIPTION MODELS
// ====================================

model MedicalRecord {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  patientId Int
  diagnosis String
  treatment String?
  notes     String?
  date      DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
}

model Prescription {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  patientId    Int
  medication   String
  dosage       String
  instructions String?
  createdAt    DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
}

// ====================================
// MESSAGE, NOTIFICATION, AUDIT LOG
// ====================================

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  sentAt     DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
